{
  "policyType": "COST",
  "version": "1.0.0",
  "rules": {
    "hardGates": {
      "atomicBudgetReservationRequired": true,
      "knownPriceRequiredBeforePaidCall": true,
      "unknownOutcomeRequiresReconciliation": true,
      "noDoubleCountingTokens": true,
      "budgetIncreaseDoesNotChangeGeneratedContent": true
    },
    "settlement": {
      "cancelOrPauseDoesNotWaiveIncurredCost": true,
      "unusedReservationReleasedOnSettlement": true
    }
  }
}
