# T04 private object storage configuration (server-side only; never from client input).
# Copy to the deployment env file and fill with real values. These complement the
# T02 database settings; they are not part of the frozen API contract.

# Enable the object store. Disabled by default until the main agent wires it at
# integration together with T03 identity (editorial.identity.enabled=true).
EDITORIAL_STORAGE_ENABLED=false

# Backend: "local" (development) or "s3" (S3-compatible private bucket).
EDITORIAL_STORAGE_MODE=local

# Maximum single-object size in bytes (default 64 MiB). Domain tasks enforce their
# own stricter limits (text upload 1 MiB, images 20 MiB) before staging.
EDITORIAL_STORAGE_MAX_OBJECT_BYTES=67108864

# Orphan TTL in seconds (default 24h). Only objects older than this AND with no
# current/historical reference and no hold are cleaned.
EDITORIAL_STORAGE_ORPHAN_TTL_SECONDS=86400

# --- Local adapter (mode=local) ---
# Private directory OUTSIDE the web root; owner-only permissions are enforced on
# POSIX. Defaults to the OS temp directory when unset (development only).
EDITORIAL_STORAGE_LOCAL_DIR=/var/lib/wxagent-editorial/storage
# Base URL and HMAC secret for signed local download URLs (>=16 chars). Storage's
# conditional LocalDownloadHandler serves these URLs; the secret never leaves the server.
EDITORIAL_STORAGE_LOCAL_DOWNLOAD_BASE=https://editorial.example.com
EDITORIAL_STORAGE_LOCAL_DOWNLOAD_SECRET=change_me_to_a_long_random_secret

# --- S3-compatible adapter (mode=s3) ---
# Private bucket, no public access. Credentials injected by the deployment secret
# manager; they are never logged, returned or written to the frontend.
EDITORIAL_STORAGE_S3_ENDPOINT=https://s3.example.com
EDITORIAL_STORAGE_S3_BUCKET=wxagent-editorial-private
EDITORIAL_STORAGE_S3_REGION=us-east-1
EDITORIAL_STORAGE_S3_ACCESS_KEY=
EDITORIAL_STORAGE_S3_SECRET_KEY=
# path-style=true for MinIO and most S3-compatible services; false for AWS virtual-hosted.
# Endpoints must have no path/query/fragment. Scheme and non-default ports are preserved.
# Explicit HTTP :80 / HTTPS :443 are omitted consistently from request and signing authority.
# Virtual-hosted mode requires a DNS endpoint and a dot-free bucket.
EDITORIAL_STORAGE_S3_PATH_STYLE=true
